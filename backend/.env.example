# neuropathy-app backend — environment template.
# Copy to .env and fill in locally: `cp .env.example .env`.
# NEVER commit .env or real values (CLAUDE.md §5); this template holds placeholders only.

APP_ENV=local
APP_DEBUG=false

# Unset = in-memory mode (unit tests / DB-less development; non-durable by design).
# Set to run against Postgres; apply migrations first: `alembic upgrade head`.
#DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/neuropathy

# JWT signing secret — required for tokens to survive restarts / multiple workers
# (ADR-0010). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
#JWT_SECRET=

# Encryption key for the DB-backed OAuth token vault (ADR-0017). Without it, DB mode
# keeps EMR tokens in a per-process in-memory vault (fail closed — plaintext tokens
# never reach the database) and they will not survive a restart. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#SECRET_STORE_KEY=

# Ops gate for clinician provisioning (ADR-0012/0017). Unset = provisioning disabled
# (fails closed). Minimum 32 characters — shorter values are refused at startup.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
#OPS_BOOTSTRAP_TOKEN=

# SMART on FHIR / EMR pull (ADR-0008/0009).
#SMART_CLIENT_ID=
#SMART_REDIRECT_URI=http://localhost:8000/emr/callback

# AI narrative layer (ADR-0011): needs a key AND the explicit operator attestation
# that a BAA covers the provider account — a key alone keeps it off.
#AI_API_KEY=
#AI_BAA_CONFIRMED=false

# Hardening knobs (ADR-0017) — sensible defaults; override only with a reason.
#PENDING_AUTH_TTL_SECONDS=600
#INVITE_RATE_LIMIT_MAX=20
#INVITE_RATE_LIMIT_WINDOW_SECONDS=3600
#BOOTSTRAP_DENIED_AUDIT_MAX=20
#BOOTSTRAP_DENIED_AUDIT_WINDOW_SECONDS=3600
