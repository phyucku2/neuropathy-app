{
  "$meta": {
    "name": "neuropathy-app design tokens",
    "version": "0.1.0",
    "source": "Derived (estimated) from BioMech Lab portal + report screenshots — see ADR-0002",
    "status": "placeholder — reconcile against BioMech Health official brand guide when available",
    "notes": "Platform-neutral source of truth. Transform to CSS/Tailwind/Swift/Kotlin as platforms are chosen. Hex values are best-estimate from screenshots."
  },
  "color": {
    "brand": {
      "navy":        { "value": "#173A5E", "use": "Deep brand navy — header base, darkest surfaces, primary text on light" },
      "navyDeep":    { "value": "#0F2A45", "use": "Header gradient dark stop" },
      "blue":        { "value": "#2E6DA4", "use": "Primary brand blue — section bars, primary UI, links" },
      "blueBright":  { "value": "#2E86C8", "use": "Header gradient bright stop, active accents" },
      "sky":         { "value": "#7FB0D4", "use": "Secondary/info blue — informational status, muted accents" },
      "skyTint":     { "value": "#E8F1F8", "use": "App background wash" }
    },
    "action": {
      "green":       { "value": "#2F8F5B", "use": "Primary action buttons (matches 'Run Custom Report')" },
      "greenHover":  { "value": "#277A4D", "use": "Primary action hover/pressed" }
    },
    "status": {
      "danger":      { "value": "#C63F4C", "use": "Urgent / expires today / red-flag" },
      "warning":     { "value": "#D68A34", "use": "Warning / expiring soon" },
      "info":        { "value": "#7FB0D4", "use": "Informational" },
      "neutral":     { "value": "#1F4E79", "use": "Neutral / expired / archived" },
      "success":     { "value": "#2F8F5B", "use": "Success / normal-range" }
    },
    "text": {
      "primary":     { "value": "#233444", "use": "Primary body text (charcoal-navy)" },
      "secondary":   { "value": "#556677", "use": "Secondary / helper text" },
      "onDark":      { "value": "#FFFFFF", "use": "Text on navy/blue/green surfaces" },
      "link":        { "value": "#2E6DA4", "use": "Links / interactive text" }
    },
    "surface": {
      "background":  { "value": "#E8F1F8", "use": "App background" },
      "card":        { "value": "#FFFFFF", "use": "Content cards / sheets" },
      "border":      { "value": "#D3DEE8", "use": "Hairlines, card borders, dividers" },
      "muted":       { "value": "#F2F6FA", "use": "Subtle fills, zebra rows" }
    }
  },
  "typography": {
    "fontFamily": {
      "display":     { "value": "Poppins", "fallback": "system-ui, sans-serif", "license": "SIL OFL 1.1", "use": "Headings, display, wordmark type" },
      "body":        { "value": "Inter", "fallback": "system-ui, sans-serif", "license": "SIL OFL 1.1", "use": "Body, UI, data tables — chosen for screen legibility (accessibility)" }
    },
    "scale": {
      "display":     { "size": 32, "lineHeight": 40, "weight": 600, "family": "display" },
      "h1":          { "size": 26, "lineHeight": 34, "weight": 600, "family": "display" },
      "h2":          { "size": 21, "lineHeight": 28, "weight": 600, "family": "display" },
      "h3":          { "size": 18, "lineHeight": 24, "weight": 600, "family": "body" },
      "body":        { "size": 17, "lineHeight": 26, "weight": 400, "family": "body", "note": "17px min body — larger baseline for older/low-vision users" },
      "bodySmall":   { "size": 15, "lineHeight": 22, "weight": 400, "family": "body" },
      "label":       { "size": 13, "lineHeight": 18, "weight": 600, "family": "body", "note": "Uppercase labels, letter-spacing 0.04em" },
      "data":        { "size": 20, "lineHeight": 24, "weight": 600, "family": "body", "note": "Numeric results / scores" }
    }
  },
  "radius": {
    "sm": { "value": 8 },
    "md": { "value": 12 },
    "lg": { "value": 16 },
    "pill": { "value": 999 }
  },
  "space": {
    "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "xxl": 48
  },
  "a11y": {
    "minTouchTarget": { "value": 48, "unit": "pt", "note": "Larger than the 44pt floor — numb-fingertip persona" },
    "minBodySize":    { "value": 17, "unit": "pt" },
    "contrastTarget": { "value": "WCAG 2.2 AA (4.5:1 text, 3:1 large text/UI)" }
  }
}
