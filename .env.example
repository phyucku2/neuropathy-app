# Staging/dev compose environment template (ADR-0018).
# Copy to .env and fill in locally: `cp .env.example .env`.
# NEVER commit .env or real values (CLAUDE.md §5); this template holds dev defaults and
# placeholders only. See docs/ops/deployment.md for which vars are SECRET and how to
# generate each, cross-referenced to backend/app/core/config.py.

# ---- Postgres (compose `db` service) ----
POSTGRES_USER=neuro
POSTGRES_DB=neuropathy
# SECRET. Dev-only default below — override for anything shared or internet-reachable.
POSTGRES_PASSWORD=change-me-dev-only

# ---- Backend ----
APP_ENV=staging
APP_DEBUG=false
WEB_CONCURRENCY=2

# SECRET. Signs JWT access/refresh tokens (ADR-0010). Required so tokens survive
# restarts / multiple workers. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SECRET. Fernet key encrypting the DB-backed OAuth token vault (ADR-0017). Without it,
# DB mode keeps EMR tokens in a per-process in-memory vault (fail closed). BACK THIS UP
# SEPARATELY FROM THE DATABASE (docs/ops/backup-restore.md). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_STORE_KEY=

# SECRET. Ops gate for clinician provisioning (ADR-0012/0017). Unset = provisioning
# disabled (fails closed). Min 32 chars — shorter is refused at startup. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OPS_BOOTSTRAP_TOKEN=

# ---- Frontend ----
# Empty = same-origin (nginx reverse-proxies the API to the backend). Set to an absolute
# URL only when the browser must reach the API on a different origin (then that origin is
# added to the CSP connect-src automatically). NOT a secret — a public URL.
API_BASE_URL=
# Host port the SPA is published on.
FRONTEND_PORT=8080
