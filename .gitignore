# Secrets / env — never commit
.env
.env.*
# ...but the template (placeholders only, never real values) is part of the repo.
!.env.example
*.pem
*.key

# Firebase / Google service-account credentials — NEVER commit (ADR-0047 B2; the real
# key is injected at runtime as a secret env var / mounted file, outside the repo).
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
firebase-admin*.json
google-services.json

# PHI guard — no real patient data or clinical report images in the repo (CLAUDE.md §5).
# De-identified transcriptions live in markdown; raw report images do not.
**/phi/
*-report-phi.*
docs/requirements/**/reports-with-phi/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build / deps (populated as the app is scaffolded)
node_modules/
dist/
build/
*.log

# Regenerable brief PDFs (source is the .html next to them)
docs/business/briefs/*.pdf

# Backend virtualenv created by the SessionStart hook
backend/.venv/
